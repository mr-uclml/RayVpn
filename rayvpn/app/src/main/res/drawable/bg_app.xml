<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#050810"
                android:centerColor="#0A1120"
                android:endColor="#070B16" />
        </shape>
    </item>
    <item android:gravity="top" android:height="340dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.35"
                android:gradientRadius="210dp"
                android:startColor="#2E1FB894"
                android:centerColor="#1218A07E"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
