<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="افزودن کانفیگ"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="لینک vless / vmess / trojan / ss / hy2، چند لینک، JSON خام Xray، یا آدرس اشتراک را بچسبانید."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/pasteBox"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:gravity="top|start"
            android:hint="vless://...  یا  https://example.com/sub"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clipBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:gravity="center"
                android:text="چسباندن"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/importBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_btn_primary"
                android:gravity="center"
                android:text="افزودن"
                android:textColor="@color/accent_ink"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ورود دستی"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_field"
            android:hint="نام"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <Spinner
            android:id="@+id/fProtocol"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/fAddress"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_field"
                android:hint="آدرس سرور"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <EditText
                android:id="@+id/fPort"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_field"
                android:hint="پورت"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted" />
        </LinearLayout>

        <EditText
            android:id="@+id/fUser"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="UUID یا رمز"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fMethod"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="رمزنگاری SS یا security وی‌مس؛ خالی = پیش‌فرض"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <Spinner
            android:id="@+id/fNetwork"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field" />

        <Spinner
            android:id="@+id/fSecurity"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field" />

        <EditText
            android:id="@+id/fSni"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="SNI"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fHost"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="Host هدر"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fPath"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="مسیر / serviceName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fFlow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="flow مثل xtls-rprx-vision"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fPbk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="کلید عمومی REALITY"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fSid"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="shortId"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/fFp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:hint="fingerprint مثل chrome"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted" />

        <CheckBox
            android:id="@+id/fInsecure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="اجازهٔ گواهی ناامن TLS"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/saveManual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="ذخیرهٔ فرم دستی"
            android:textColor="@color/accent_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
