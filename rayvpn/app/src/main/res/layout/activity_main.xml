<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- ── header ─────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_box">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/versionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:text="در حال دریافت سرورها"
                    android:textColor="@color/muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/refreshBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/refreshIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="تازه‌سازی"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/accent" />
            </FrameLayout>
        </LinearLayout>

        <!-- ── update banner ──────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/updateBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_update"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingTop="9dp"
            android:paddingEnd="8dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="آپدیت"
                android:src="@drawable/ic_bolt"
                android:tint="@color/accent" />

            <TextView
                android:id="@+id/updateText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="آپدیت لیست آمد"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/updateBtn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="به‌روزرسانی"
                android:textColor="@color/accent_ink"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── hero card ──────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="15dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:text="قطع"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/connectWrap"
                android:layout_width="178dp"
                android:layout_height="178dp"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/glow"
                    android:layout_width="172dp"
                    android:layout_height="172dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_glow" />

                <View
                    android:id="@+id/spinRing"
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_spin"
                    android:visibility="gone" />

                <View
                    android:id="@+id/ringA"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring"
                    android:visibility="gone" />

                <View
                    android:id="@+id/ringB"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/connectBtn"
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_connect"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="اتصال"
                    android:textColor="@color/accent_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/serverName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="سروری انتخاب نشده"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="یک سرور را از لیست انتخاب کنید"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ── actions ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pingAllBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:drawableStart="@drawable/ic_pulse"
                android:drawablePadding="7dp"
                android:drawableTint="@color/accent_ink"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="پینگ همه"
                android:textColor="@color/accent_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/sortBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:clickable="true"
                android:drawableStart="@drawable/ic_sort"
                android:drawablePadding="7dp"
                android:drawableTint="@color/text_dim"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="مرتب‌سازی"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── server list ────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/listWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:drawSelectorOnTop="true"
                android:listSelector="@drawable/row_selector"
                android:paddingBottom="6dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableTop="@drawable/ic_pulse"
                android:drawablePadding="12dp"
                android:drawableTint="@color/muted_soft"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:text="در حال دریافت کانفیگ‌ها…"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
