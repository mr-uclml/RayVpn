<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RayVPN" parent="android:Theme.Material.NoActionBar">
        <item name="rayBg">@color/d_bg</item>
        <item name="rayBg2">@color/d_bg2</item>
        <item name="raySurface">@color/d_surface</item>
        <item name="raySurface2">@color/d_surface2</item>
        <item name="rayLine">@color/d_line</item>
        <item name="rayLineSoft">@color/d_line_soft</item>
        <item name="rayText">@color/d_text</item>
        <item name="rayTextDim">@color/d_text_dim</item>
        <item name="rayMuted">@color/d_muted</item>
        <item name="rayAccent">@color/d_accent</item>
        <item name="rayAccentInk">@color/d_accent_ink</item>
        <item name="rayAccentSoft">@color/d_accent_soft</item>
        <item name="rayAccentGhost">@color/d_accent_ghost</item>
        <item name="rayGlow">@color/d_glow</item>
        <item name="rayDanger">@color/d_danger</item>
        <item name="rayWarn">@color/d_warn</item>
        <item name="rayScreen">@drawable/bg_screen</item>

        <item name="android:windowBackground">?attr/rayScreen</item>
        <item name="android:colorPrimary">?attr/rayBg</item>
        <item name="android:colorPrimaryDark">?attr/rayBg</item>
        <item name="android:colorAccent">?attr/rayAccent</item>
        <item name="android:colorControlHighlight">?attr/rayAccentGhost</item>
        <item name="android:colorEdgeEffect">?attr/rayAccent</item>
        <item name="android:statusBarColor">?attr/rayBg</item>
        <item name="android:navigationBarColor">?attr/rayBg</item>
        <item name="android:textColor">?attr/rayText</item>
        <item name="android:textColorPrimary">?attr/rayText</item>
        <item name="android:textColorSecondary">?attr/rayMuted</item>
        <item name="android:textColorHint">?attr/rayMuted</item>
        <item name="android:windowAnimationStyle">@style/Anim.Ray.Window</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.RayVPN.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="rayBg">@color/l_bg</item>
        <item name="rayBg2">@color/l_bg2</item>
        <item name="raySurface">@color/l_surface</item>
        <item name="raySurface2">@color/l_surface2</item>
        <item name="rayLine">@color/l_line</item>
        <item name="rayLineSoft">@color/l_line_soft</item>
        <item name="rayText">@color/l_text</item>
        <item name="rayTextDim">@color/l_text_dim</item>
        <item name="rayMuted">@color/l_muted</item>
        <item name="rayAccent">@color/l_accent</item>
        <item name="rayAccentInk">@color/l_accent_ink</item>
        <item name="rayAccentSoft">@color/l_accent_soft</item>
        <item name="rayAccentGhost">@color/l_accent_ghost</item>
        <item name="rayGlow">@color/l_glow</item>
        <item name="rayDanger">@color/l_danger</item>
        <item name="rayWarn">@color/l_warn</item>
        <item name="rayScreen">@drawable/bg_screen_light</item>

        <item name="android:windowBackground">?attr/rayScreen</item>
        <item name="android:colorPrimary">?attr/rayBg</item>
        <item name="android:colorPrimaryDark">?attr/rayBg</item>
        <item name="android:colorAccent">?attr/rayAccent</item>
        <item name="android:colorControlHighlight">?attr/rayAccentGhost</item>
        <item name="android:colorEdgeEffect">?attr/rayAccent</item>
        <item name="android:statusBarColor">?attr/rayBg</item>
        <item name="android:navigationBarColor">?attr/rayBg</item>
        <item name="android:textColor">?attr/rayText</item>
        <item name="android:textColorPrimary">?attr/rayText</item>
        <item name="android:textColorSecondary">?attr/rayMuted</item>
        <item name="android:textColorHint">?attr/rayMuted</item>
        <item name="android:windowAnimationStyle">@style/Anim.Ray.Window</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.RayVPN.Splash" parent="Theme.RayVPN">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#08090C</item>
        <item name="android:navigationBarColor">#08090C</item>
    </style>

</resources>
